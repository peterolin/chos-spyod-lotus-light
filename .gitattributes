# Text files: normalize to LF in the repo.
* text=auto

# EPUB sources under src/ are text and must diff cleanly.
*.htm    text eol=lf
*.xhtml  text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.opf    text eol=lf
*.ncx    text eol=lf
*.xml    text eol=lf

# mimetype must be byte-exact — no EOL normalization, ever.
src/mimetype -text

# Binaries: never touch these.
*.epub   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.jpeg   binary
*.jpg    binary
*.png    binary
*.pdf    binary
*.xcf    binary
*.iba    binary
