# Build output — the EPUB is generated from src/, never committed.
build/

# macOS
.DS_Store

# Python bytecode from tools/
__pycache__/
*.pyc

# Build counter — per-machine, must not dirty the tree
.buildnum

# the pecha PDF (65 MB) — reference only, converted text lives in resources/pecha-unicode/
resources/*.pdf

# The Ngondro proof text and everything drawn out of it. The source PDF is
# marked DO NOT SHARE and this repository has a public remote, so the
# extracted streams stay out of it too.
resources/ngondro-proof/
